{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git pull *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(touch *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(grep *)",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(wget *)",
      "Bash(chmod 777 *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(pip uninstall *)",
      "Bash(uv add *)",
      "Bash(uv unadd *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(git push *)",
      "Bash(curl *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "frontend-design": "off",
    "spinner": "off",
    "writing-guide": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "node \"C:/Users/hirakoba/.claude/hooks/statusline.js\"",
    "padding": 0,
    "refreshInterval": 60
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "🐞 覚悟はいいか？オレはできてる",
      "🌟 このジョルノ・ジョバァーナには夢がある",
      "👊 無駄ァッ！無駄無駄無駄ァッ！",
      "🤵 「任務(ミッション)」は遂行する、部下も守る",
      "🤵 オレは『結果』だけを求めてはいない",
      "👅 この味は！…ウソをついてる『味』だぜ",
      "🎯 だが4は嫌だ！4以外にしろ！",
      "📼 覚悟…決意…そして『信念(ソウル)』…",
      "📞 とぅるるる…はい、ドッピオです",
      "🎲 これが『キング・クリムゾン』の力…",
      "🎲 消し飛んだ時間の中を進んでいる",
      "🐢 スティッキィ・フィンガーズでジッパーを開けている",
      "🌀 亀(ミスタァ・チューブラー・ベルズ)の中で待機中",
      "🏛️ アリーヴェデルチ(さよならだ)",
      "✨ なんという… 黄金の精神(ゴールド・エクスペリエンス・レクイエム)…",
      "無駄無駄無駄無駄無駄無駄無駄無駄"
    ]
  },
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "autoMemoryEnabled": true,
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true
}
