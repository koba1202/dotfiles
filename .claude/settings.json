{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git pull *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(touch *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(wget *)",
      "Bash(chmod 777 *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(pip uninstall *)",
      "Bash(uv add *)",
      "Bash(uv unadd *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(git push *)",
      "Bash(curl *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Import-Module BurntToast; New-BurntToastNotification -Text 'Claude Code', '処理が完了しました'\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Import-Module BurntToast; New-BurntToastNotification -Text 'Claude Code', '処理が完了しました'\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx ccusage@latest statusline"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "🐞 覚悟はいいか？オレはできてる",
      "🌟 このジョルノ・ジョバァーナには夢がある",
      "🌟 だが それが「いい」…",
      "👊 無駄ァッ！無駄無駄無駄ァッ！",
      "🤵 「任務(ミッション)」は遂行する 「成功(サクセス)」は掴む",
      "🤵 オレは『結果』だけを求めてはいない",
      "👅 この味は！…ウソをついてる『味』だぜ",
      "🎯 だが4は嫌だ！4以外にしろ！",
      "📼 覚悟…決意…そして『信念(ソウル)』…",
      "📞 とぅるるる…はい、ドッピオです",
      "🎲 これが『キング・クリムゾン』の力…",
      "🎲 消し飛んだ時間の中を進んでいる",
      "🐢 スティッキィ・フィンガーズでジッパーを開けている",
      "🌀 亀(ミスタァ・チューブラー・ベルズ)の中で待機中",
      "🏛️ アリーヴェデルチ(さよならだ)",
      "✨ なんという… 黄金の精神(ゴールド・エクスペリエンス・レクイエム)…",
      "無駄無駄無駄無駄無駄無駄無駄無駄"
    ]
  },
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true
}
